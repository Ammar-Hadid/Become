# PostgreSQL is the canonical data store. The docker-compose default is shown here.
DATABASE_URL="postgresql://become:become@localhost:5432/become?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3010"

# Used for all calendar boundaries and display formatting.
APP_TIMEZONE="Europe/Amsterdam"

# Dedicated persistent root, outside the deployment in production.
# Development defaults to <repository>/.data/become (gitignored).
# Hetzner production example: BECOME_DATA_DIR="/srv/data/become"
# Media is held beneath this root at media/seasons/...; PostgreSQL stores keys only.
BECOME_DATA_DIR=""
