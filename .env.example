# PostgreSQL is the canonical data store. The docker-compose default is shown here.
DATABASE_URL="postgresql://become:become@localhost:5432/become?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3010"
# Defaults to true locally and false in production. Enable only for controlled signup.
# BECOME_ALLOW_SIGNUP="true"

# Used for all calendar boundaries and display formatting.
APP_TIMEZONE="Europe/Amsterdam"

# Dedicated persistent root, outside the deployment in production.
# Development defaults to <repository>/.data/become (gitignored).
# Hetzner production example: BECOME_DATA_DIR="/srv/data/become"
# Media is held beneath this root at media/{seasons,content,content-scripts}/...
# PostgreSQL stores keys only. Set the root, not the media subdirectory.
BECOME_DATA_DIR=""

# Character identity suggestions use Wikidata; image and quote search are removed.
# Set to "none" to disable identity suggestions.
COTS_ENABLED_PROVIDERS="wikidata,anilist,jikan"

# Explicit owner for the private Image Direction studio. No account is inferred from creation order.
# If omitted, the earliest registered Become account is the owner.
BECOME_OWNER_EMAIL=""

# Nexo utility synthesis. Never expose this credential as NEXT_PUBLIC.
# Choose a model profile and explicitly generate in Settings → Nexo / So Far We Know.
OPENAI_API_KEY=""

# Enable Banking: server-side, consent-based personal-account access.
# Upload the matching public certificate in the provider control panel.
ENABLE_BANKING_APP_ID=""
ENABLE_BANKING_PRIVATE_KEY_PATH=""
# Record the actual agreed total monthly cost; maximum EUR 10.
OPEN_BANKING_MONTHLY_COST_EUR="0"
# Integration cadence, not a Finance-domain rule. Respect provider limits.
OPEN_BANKING_SYNC_INTERVAL_SECONDS="21600"
# Seconds keyed by provider:country:institution, using exact discovery names.
OPEN_BANKING_INSTITUTION_CADENCE_JSON="{}"
# Optional dedicated encryption secret for API keys entered in Settings → Nexo.
# Generate with: openssl rand -base64 32. Keep it stable: changing it makes saved keys unreadable.
# If omitted, Become derives key encryption from BETTER_AUTH_SECRET.
BECOME_AI_KEY_SECRET=""

# Isolated character-source quality trial only; not used by connected onboarding.
# Create a free key, disable paid usage in Tavily, then run tools/character-source-trial.ts.
# Never expose as NEXT_PUBLIC. Existing Nexo/Gemini credentials are unrelated.
TAVILY_API_KEY=""
