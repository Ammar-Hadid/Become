# PostgreSQL is the canonical data store. The docker-compose default is shown here.
DATABASE_URL="postgresql://become:become@localhost:5432/become?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3010"

# Used for all calendar boundaries and display formatting.
APP_TIMEZONE="Europe/Amsterdam"

# Dedicated persistent root, outside the deployment in production.
# Development defaults to <repository>/.data/become (gitignored).
# Hetzner production example: BECOME_DATA_DIR="/srv/data/become"
# Media is held beneath this root at media/seasons/...; PostgreSQL stores keys only.
BECOME_DATA_DIR=""

# Phase 5.5 COTS: HTTP adapters only. Never expose these as NEXT_PUBLIC variables.
# No provider accounts or paid subscriptions are created by Become.
COTS_ENABLED_PROVIDERS="wikidata,commons,wikiquote,wikisource,zerochan,serpapi,animechan,brave,clipcafe,stands4,community"
COTS_MONTHLY_SPEND_LIMIT_USD="0"
COTS_MAX_IMAGES="24"
COTS_MAX_QUOTES="48"
COTS_ZEROCHAN_USERNAME=""
# Optional canonical aliases: {"display name|source work":"canonical tag"}
COTS_ZEROCHAN_TAGS_JSON="{}"
COTS_SERPAPI_API_KEY=""
COTS_SERPAPI_PLAN="free"
COTS_BRAVE_SEARCH_API_KEY=""
COTS_BRAVE_STORAGE_ALLOWED="false"
COTS_CLIPCAFE_API_KEY=""
COTS_CLIPCAFE_RETENTION_ALLOWED="false"
# Actual approved monthly USD cost including taxes; required before activation.
COTS_CLIPCAFE_MONTHLY_COST_USD="0"
COTS_STANDS4_UID=""
COTS_STANDS4_TOKEN_ID=""
COTS_STANDS4_RETENTION_ALLOWED="false"
