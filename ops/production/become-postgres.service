[Unit]
Description=Become dedicated PostgreSQL database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/apps/become/postgresql
ExecStart=/usr/bin/docker compose up -d --wait --wait-timeout 90
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=120
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
