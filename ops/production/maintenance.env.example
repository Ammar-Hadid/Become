# Root only: /etc/become/maintenance.env, root:root 0600.
# Owner role, direct (non-pooler) endpoint. Used only for migrations and backups.
DIRECT_DATABASE_URL='postgresql://become_owner:URL_ENCODED_PASSWORD@NEON_DIRECT_HOST/become?sslmode=verify-full&channel_binding=require'
PGSSLROOTCERT='/etc/ssl/certs/ca-certificates.crt'
