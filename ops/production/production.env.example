# Copy to /etc/become/production.env, root:become 0640. Never commit real values.
# Single quotes are compatible with both systemd EnvironmentFile and bash source.
NODE_ENV='production'
# Localhost-only PostgreSQL; remote administration uses an encrypted SSH tunnel.
DATABASE_URL='postgresql://become_app:URL_ENCODED_PASSWORD@127.0.0.1:15433/become?sslmode=disable'
BETTER_AUTH_SECRET='REPLACE_WITH_OPENSSL_RAND_HEX_32_OUTPUT'
BETTER_AUTH_URL='https://become.example.com'
APP_TIMEZONE='Europe/Amsterdam'
BECOME_DATA_DIR='/srv/data/become'
BECOME_ALLOW_SIGNUP='false'
NEXT_TELEMETRY_DISABLED='1'
# Explicitly disables all optional discovery providers for the first launch.
# An empty value means all providers, so use "none" here.
COTS_ENABLED_PROVIDERS='none'
COTS_MONTHLY_SPEND_LIMIT_USD='0'

# Enable only after personal-access whitelisting and sandbox verification.
ENABLE_BANKING_APP_ID=''
ENABLE_BANKING_PRIVATE_KEY_PATH='/etc/become/enable-banking-private.key'
OPEN_BANKING_MONTHLY_COST_EUR='0'
OPEN_BANKING_SYNC_INTERVAL_SECONDS='21600'
OPEN_BANKING_INSTITUTION_CADENCE_JSON='{}'
