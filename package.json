{
  "name": "become",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3010",
    "dev:seasons": "node --import tsx tools/dev-seasons.ts",
    "check:seasons": "node --conditions=react-server --import tsx tools/check-season-onboarding.ts",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --output-dir storybook-static",
    "build": "next build --webpack",
    "start": "next start -p 3010",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:sync-tech": "prisma db seed -- --reference-data-only",
    "db:studio": "prisma studio",
    "test:finance:integration": "RUN_FINANCE_INTEGRATION=1 vitest run src/features/finance/services/finance.integration.test.ts",
    "bank:worker": "tsx src/features/open-banking/sync/services/bank-worker.service.ts",
    "worker:seasons": "node --conditions=react-server --import tsx tools/season-onboarding-worker.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-find-and-replace": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.16",
    "dotenv": "^17.2.2",
    "geist": "^1.7.0",
    "lucide-react": "^0.544.0",
    "luxon": "^3.7.2",
    "mammoth": "^1.12.2",
    "next": "^16.3.6",
    "openai": "^7.20.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "simple-icons": "^16.29.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "prisma": "7.10.0",
    "storybook": "10.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.0"
  }
}
