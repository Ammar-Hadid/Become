generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EngineeringProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
}

enum EngineeringContext {
  UNI
  INTERNSHIP
  PERSONAL
  PROFESSIONAL
}

enum EngineeringEvidenceType {
  FEATURE_COMPLETED
  BUG_SOLVED
  CONCEPT_LEARNED
  DEPLOYMENT
  ARCHITECTURE_DECISION
  TECHNICAL_DISCOVERY
}

enum TechnologyCategory {
  LANGUAGE
  FRAMEWORK
  LIBRARY
  DATABASE
  RUNTIME
  ORM_DATA
  TESTING
  BUILD_TOOL
  INFRASTRUCTURE
  PLATFORM
  TOOL
  OTHER
}

model User {
  businessOffers Offer[]
  businessReceiptAllocations BusinessReceiptAllocation[]
  businessInteractions Interaction[]
  businessObservations Observation[]
  businessProblems Problem[]
  businessFollowUps FollowUp[]
  businessCompanies Company[]
  businessNiches Niche[]
  businessCaptures BusinessCapture[]
  id                  String                            @id @default(cuid())
  name                String
  email               String                            @unique
  emailVerified       Boolean                           @default(false)
  image               String?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  authSessions        AuthSession[]
  accounts            Account[]
  domains             Domain[]
  sessions            Session[]
  engineeringProjects EngineeringProject[]
  engineeringEvidence EngineeringEvidence[]
  technologies        Technology[]
  financialAccounts   FinancialAccount[]
  balanceSnapshots    FinancialAccountBalanceSnapshot[]

  financialTransactions FinancialTransaction[]
  expenseCategories     ExpenseCategory[]
  counterparties        Counterparty[]

  financePolicies FinanceCurrencyPolicy[]

  savingsGoals SavingsGoal[]
  goalExpenses SavingsGoalExpenseAllocation[]

  recurringExpenses RecurringExpense[]

  recurringOccurrences RecurringExpenseOccurrence[]

  workSources         WorkSource[]
  incomeOpportunities IncomeOpportunity[]

  paymentAllocations PaymentSessionAllocation[]

  @@map("user")
}

model Company {
  businessSessions Session[] @relation("BusinessSessionCompany")
  offers Offer[]
  receiptAllocations BusinessReceiptAllocation[]
  workSources CompanyWorkSource[]
  interactionRevisions InteractionRevision[]
  observationRevisions ObservationRevision[]
  followUps FollowUp[]
  id String @id @default(cuid())
  userId String
  name String
  normalizedName String
  website String?
  notes String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  niches CompanyNiche[]
  @@unique([id, userId])
  @@unique([userId, normalizedName])
  @@index([userId, createdAt, id])
  @@map("company")
}

model Niche {
  businessSessions Session[] @relation("BusinessSessionNiche")
  interactionRevisions InteractionRevision[]
  observationRevisions ObservationRevision[]
  problems Problem[]
  id String @id @default(cuid())
  userId String
  name String
  normalizedName String
  scope String?
  direction String @default("EXPLORING")
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  companies CompanyNiche[]
  decisions NicheDecision[]
  offers OfferNiche[]
  @@unique([id, userId])
  @@unique([userId, normalizedName])
  @@map("niche")
}

model Interaction {
  id String @id @default(cuid())
  userId String
  version Int @default(1)
  voidedAt DateTime?
  voidReason String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions InteractionRevision[] @relation("InteractionHistory")
  replies InteractionRevision[] @relation("ReplyTarget")
  followUps FollowUp[]
  @@unique([id, userId])
  @@index([userId, createdAt, id])
  @@map("interaction")
}

model InteractionRevision {
  sourceSessionId String?
  sourceSession Session? @relation(fields: [sourceSessionId, userId], references: [id, userId], onDelete: Restrict)
  offerEvents OfferEvent[]
  id String @id @default(cuid())
  userId String
  interactionId String
  version Int
  companyId String?
  nicheId String?
  companySnapshot String?
  nicheSnapshot String?
  respondsToInteractionId String?
  kind String
  channel String
  occurredAt DateTime
  datePrecision String @default("DAY")
  summary String
  notes String?
  participants Json @default("[]")
  correctionReason String?
  materialChange Boolean @default(false)
  createdAt DateTime @default(now())
  interaction Interaction @relation("InteractionHistory", fields: [interactionId, userId], references: [id, userId], onDelete: Cascade)
  company Company? @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  niche Niche? @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Restrict)
  respondsTo Interaction? @relation("ReplyTarget", fields: [respondsToInteractionId, userId], references: [id, userId], onDelete: Restrict)
  observations ObservationRevision[]
  @@unique([interactionId, version])
  @@unique([id, interactionId, userId])
  @@unique([id, userId])
  @@index([userId, occurredAt, id])
  @@index([companyId, occurredAt])
  @@map("interaction_revision")
}

model Observation {
  id String @id @default(cuid())
  userId String
  version Int @default(1)
  voidedAt DateTime?
  voidReason String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions ObservationRevision[]
  evidence ProblemEvidence[] @relation("LogicalObservationEvidence")
  @@unique([id, userId])
  @@map("observation")
}

model ObservationRevision {
  id String @id @default(cuid())
  userId String
  observationId String
  version Int
  kind String
  wordingMode String
  statement String
  observedAt DateTime
  companyId String?
  nicheId String?
  companySnapshot String?
  nicheSnapshot String?
  sourceKind String
  interactionId String?
  interactionRevisionId String?
  sourceUrl String?
  sourceDescription String
  correctionReason String?
  materialChange Boolean @default(false)
  createdAt DateTime @default(now())
  observation Observation @relation(fields: [observationId, userId], references: [id, userId], onDelete: Cascade)
  company Company? @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  niche Niche? @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Restrict)
  interactionRevision InteractionRevision? @relation(fields: [interactionRevisionId, interactionId, userId], references: [id, interactionId, userId], onDelete: Restrict)
  evidence ProblemEvidence[] @relation("ObservationVersionEvidence")
  @@unique([observationId, version])
  @@unique([id, observationId, userId])
  @@map("observation_revision")
}

model Problem {
  offerRevisions OfferRevisionProblem[]
  id String @id @default(cuid())
  userId String
  title String
  initialStatement String
  origin String
  formulatedAt DateTime @default(now())
  nicheId String?
  nicheSnapshot String?
  notes String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche Niche? @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Restrict)
  evidence ProblemEvidence[]
  assessments ProblemAssessment[]
  @@unique([id, userId])
  @@index([userId, createdAt, id])
  @@map("problem")
}

model ProblemEvidence {
  receiptSnapshot Json?
  receiptAllocationId String?
  receiptAllocation BusinessReceiptAllocation? @relation(fields: [receiptAllocationId, userId], references: [id, userId], onDelete: Restrict)
  id String @id @default(cuid())
  userId String
  problemId String
  observationId String?
  observationRevisionId String?
  stance String
  explanation String
  confirmedAt DateTime @default(now())
  withdrawnAt DateTime?
  withdrawalReason String?
  createdAt DateTime @default(now())
  problem Problem @relation(fields: [problemId, userId], references: [id, userId], onDelete: Cascade)
  observation Observation? @relation("LogicalObservationEvidence", fields: [observationId, userId], references: [id, userId], onDelete: Restrict)
  observationRevision ObservationRevision? @relation("ObservationVersionEvidence", fields: [observationRevisionId, observationId, userId], references: [id, observationId, userId], onDelete: Restrict)
  assessmentBasis ProblemAssessmentEvidence[]
  @@unique([id, problemId, userId])
  @@index([problemId, withdrawnAt])
  @@map("problem_evidence")
}

model ProblemAssessment {
  id String @id @default(cuid())
  userId String
  problemId String
  state String
  scope String
  rationale String
  assessedAt DateTime
  createdAt DateTime @default(now())
  problem Problem @relation(fields: [problemId, userId], references: [id, userId], onDelete: Cascade)
  basis ProblemAssessmentEvidence[]
  @@unique([id, problemId, userId])
  @@index([problemId, assessedAt])
  @@map("problem_assessment")
}

model ProblemAssessmentEvidence {
  userId String
  problemId String
  assessmentId String
  evidenceId String
  assessment ProblemAssessment @relation(fields: [assessmentId, problemId, userId], references: [id, problemId, userId], onDelete: Cascade)
  evidence ProblemEvidence @relation(fields: [evidenceId, problemId, userId], references: [id, problemId, userId], onDelete: Restrict)
  @@id([assessmentId, evidenceId])
  @@map("problem_assessment_evidence")
}

model FollowUp {
  offerId String?
  offer Offer? @relation(fields: [offerId, userId], references: [id, userId], onDelete: Restrict)
  id String @id @default(cuid())
  userId String
  companyId String?
  interactionId String?
  title String
  dueOn DateTime? @db.Date
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  interaction Interaction? @relation(fields: [interactionId, userId], references: [id, userId], onDelete: Restrict)
  @@unique([id, userId])
  @@index([userId, dueOn, completedAt])
  @@map("follow_up")
}

model CompanyNiche {
  userId String
  companyId String
  nicheId String
  company Company @relation(fields: [companyId, userId], references: [id, userId], onDelete: Cascade)
  niche Niche @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Restrict)
  @@id([companyId, nicheId])
  @@map("company_niche")
}

model NicheDecision {
  id String @id @default(cuid())
  userId String
  nicheId String
  direction String
  rationale String
  scopeSnapshot String?
  createdAt DateTime @default(now())
  niche Niche @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Cascade)
  @@index([nicheId, createdAt])
  @@map("niche_decision")
}

// One key represents one explicit submission, not deduplication of similar facts.
model BusinessCapture {
  id String @id
  userId String
  fingerprint String
  resultId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([id, userId])
  @@map("business_capture")
}

model AuthSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Domain {
  id             String         @id @default(cuid())
  userId         String
  name           String
  slug           String
  icon           String
  analyticsColor String?
  sortOrder      Int            @default(0)
  enabled        Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityTypes  ActivityType[]
  sessions       Session[]

  @@unique([id, userId])
  @@unique([userId, slug])
  @@index([userId, sortOrder])
  @@map("domain")
}

model ActivityType {
  id                  String               @id @default(cuid())
  domainId            String
  name                String
  slug                String
  sortOrder           Int                  @default(0)
  enabled             Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  domain              Domain               @relation(fields: [domainId], references: [id], onDelete: Cascade)
  sessions            Session[]
  financeActivityKind FinanceActivityKind?

  @@unique([id, domainId])
  @@unique([domainId, slug])
  @@index([domainId, sortOrder])
  @@map("activity_type")
}

model Session {
  entrepreneurshipActivityKind String?
  businessCompanyId String?
  businessNicheId String?
  businessCompanySnapshot String?
  businessNicheSnapshot String?
  businessCompany Company? @relation("BusinessSessionCompany", fields: [businessCompanyId, userId], references: [id, userId], onDelete: Restrict)
  businessNiche Niche? @relation("BusinessSessionNiche", fields: [businessNicheId, userId], references: [id, userId], onDelete: Restrict)
  businessInteractionRevisions InteractionRevision[]
  id                           String                     @id @default(cuid())
  userId                       String
  domainId                     String
  activityTypeId               String
  engineeringProjectId         String?
  engineeringContext           EngineeringContext?
  startedAt                    DateTime
  endedAt                      DateTime?
  description                  String?
  outcome                      String?
  notes                        String?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain                       Domain                     @relation(fields: [domainId, userId], references: [id, userId], onDelete: Restrict)
  activityType                 ActivityType               @relation(fields: [activityTypeId, domainId], references: [id, domainId], onDelete: Restrict)
  engineeringProject           EngineeringProject?        @relation("EngineeringProjectSessions", fields: [engineeringProjectId, userId], references: [id, userId], onDelete: Restrict)
  engineeringEvidence          EngineeringEvidence[]      @relation("EngineeringEvidenceSession")
  financeActivityKind          FinanceActivityKind?
  workSourceId                 String?
  incomeOpportunityId          String?
  financeCompensationType      FinanceCompensationType?
  paymentAttributionCompleteAt DateTime?
  workSource                   WorkSource?                @relation(fields: [workSourceId, userId], references: [id, userId], onDelete: Restrict)
  incomeOpportunity            IncomeOpportunity?         @relation(fields: [incomeOpportunityId, userId], references: [id, userId], onDelete: Restrict)
  paymentAllocations           PaymentSessionAllocation[]

  @@unique([id, userId])
  @@index([userId, startedAt])
  @@index([userId, endedAt])
  @@index([domainId, startedAt])
  @@index([userId, engineeringProjectId, startedAt])
  @@index([userId, engineeringContext, startedAt])
  @@index([userId, financeActivityKind, startedAt])
  @@map("session")
}

model EngineeringProject {
  id            String                         @id @default(cuid())
  userId        String
  name          String                         @db.VarChar(120)
  description   String?                        @db.Text
  context       EngineeringContext             @default(PERSONAL)
  status        EngineeringProjectStatus       @default(ACTIVE)
  repositoryUrl String?                        @db.VarChar(2048)
  liveUrl       String?                        @db.VarChar(2048)
  notes         String?                        @db.Text
  startedOn     DateTime?                      @db.Date
  completedOn   DateTime?                      @db.Date
  archivedAt    DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  user          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      Session[]                      @relation("EngineeringProjectSessions")
  evidence      EngineeringEvidence[]          @relation("EngineeringProjectEvidence")
  technologies  EngineeringProjectTechnology[]

  @@unique([id, userId])
  @@index([userId, archivedAt, status])
  @@index([userId, context, createdAt])
  @@map("engineering_project")
}

model EngineeringEvidence {
  id         String                  @id @default(cuid())
  userId     String
  type       EngineeringEvidenceType
  title      String                  @db.VarChar(160)
  details    String?                 @db.Text
  occurredAt DateTime                @default(now())
  projectId  String?
  sessionId  String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    EngineeringProject?     @relation("EngineeringProjectEvidence", fields: [projectId, userId], references: [id, userId], onDelete: Restrict)
  session    Session?                @relation("EngineeringEvidenceSession", fields: [sessionId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([userId, projectId, occurredAt])
  @@index([userId, sessionId])
  @@map("engineering_evidence")
}

model Technology {
  id           String                         @id @default(cuid())
  userId       String?
  name         String                         @db.VarChar(80)
  slug         String                         @db.VarChar(80)
  category     TechnologyCategory
  iconKey      String?                        @db.VarChar(80)
  isBuiltIn    Boolean                        @default(false)
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  user         User?                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectLinks EngineeringProjectTechnology[]

  @@unique([userId, slug])
  @@index([isBuiltIn, category, name])
  @@map("technology")
}

model EngineeringProjectTechnology {
  engineeringProjectId String
  technologyId         String
  createdAt            DateTime           @default(now())
  engineeringProject   EngineeringProject @relation(fields: [engineeringProjectId], references: [id], onDelete: Cascade)
  technology           Technology         @relation(fields: [technologyId], references: [id], onDelete: Restrict)

  @@id([engineeringProjectId, technologyId])
  @@index([technologyId])
  @@map("engineering_project_technology")
}

enum FinancialAccountType {
  CHECKING
  SAVINGS
  CASH
  DIGITAL_WALLET
  OTHER
}

model FinancialAccount {
  id                     String                            @id @default(cuid())
  userId                 String
  name                   String                            @db.VarChar(120)
  type                   FinancialAccountType
  currency               String                            @db.VarChar(3)
  includeInLiquidSavings Boolean                           @default(false)
  archivedAt             DateTime?
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt
  user                   User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots              FinancialAccountBalanceSnapshot[]

  outgoing             FinancialTransaction[]       @relation("TransactionAccount")
  incoming             FinancialTransaction[]       @relation("TransferDestination")
  recurringExpenses    RecurringExpense[]
  recurringOccurrences RecurringExpenseOccurrence[]

  @@unique([id, userId])
  @@unique([id, userId, currency])
  @@index([userId, archivedAt])
  @@map("financial_account")
}

model FinancialAccountBalanceSnapshot {
  id           String           @id @default(cuid())
  userId       String
  accountId    String
  balanceMinor BigInt
  reconciledAt DateTime
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      FinancialAccount @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([accountId, reconciledAt])
  @@index([userId, accountId, reconciledAt])
  @@map("financial_account_balance_snapshot")
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum FinancialInflowKind {
  EARNED_WORK
  BUSINESS_REVENUE
  STUDENT_FINANCE
  GIFT
  REFUND
  REIMBURSEMENT
  OTHER
}

model ExpenseCategory {
  id                   String                       @id @default(cuid())
  userId               String
  name                 String                       @db.VarChar(120)
  normalizedName       String                       @db.VarChar(120)
  archivedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         FinancialTransaction[]
  recurringExpenses    RecurringExpense[]
  recurringOccurrences RecurringExpenseOccurrence[]

  @@unique([id, userId])
  @@unique([userId, normalizedName])
  @@map("expense_category")
}

model Counterparty {
  id                   String                       @id @default(cuid())
  userId               String
  name                 String                       @db.VarChar(120)
  normalizedName       String                       @db.VarChar(120)
  archivedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         FinancialTransaction[]
  recurringExpenses    RecurringExpense[]
  recurringOccurrences RecurringExpenseOccurrence[]

  @@unique([id, userId])
  @@unique([userId, normalizedName])
  @@index([userId, archivedAt, name])
  @@map("counterparty")
}

model FinancialTransaction {
  businessReceiptAllocations BusinessReceiptAllocation[]
  id                           String                         @id @default(cuid())
  userId                       String
  type                         FinancialTransactionType
  amountMinor                  BigInt
  currency                     String                         @db.VarChar(3)
  occurredAt                   DateTime
  accountId                    String
  destinationAccountId         String?
  inflowKind                   FinancialInflowKind?
  expenseCategoryId            String?
  counterpartyId               String?
  notes                        String?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  user                         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                      FinancialAccount               @relation("TransactionAccount", fields: [accountId, userId, currency], references: [id, userId, currency], onDelete: Restrict)
  destinationAccount           FinancialAccount?              @relation("TransferDestination", fields: [destinationAccountId, userId, currency], references: [id, userId, currency], onDelete: Restrict)
  expenseCategory              ExpenseCategory?               @relation(fields: [expenseCategoryId, userId], references: [id, userId], onDelete: Restrict)
  counterparty                 Counterparty?                  @relation(fields: [counterpartyId, userId], references: [id, userId], onDelete: Restrict)
  goalAllocations              SavingsGoalExpenseAllocation[]
  recurringExpenseOccurrenceId String?                        @unique
  recurringExpenseOccurrence   RecurringExpenseOccurrence?    @relation(fields: [recurringExpenseOccurrenceId, userId], references: [id, userId], onDelete: Restrict)
  workSourceId                 String?
  incomeOpportunityId          String?
  workSource                   WorkSource?                    @relation(fields: [workSourceId, userId], references: [id, userId], onDelete: Restrict)
  incomeOpportunity            IncomeOpportunity?             @relation(fields: [incomeOpportunityId, userId], references: [id, userId], onDelete: Restrict)
  paymentAllocations           PaymentSessionAllocation[]

  @@unique([id, userId])
  @@unique([recurringExpenseOccurrenceId, userId])
  @@index([userId, occurredAt, id])
  @@index([userId, accountId, occurredAt])
  @@index([userId, destinationAccountId, occurredAt])
  @@index([userId, counterpartyId, occurredAt])
  @@index([userId, workSourceId, occurredAt])
  @@index([userId, incomeOpportunityId, occurredAt])
  @@map("financial_transaction")
}

model FinanceCurrencyPolicy {
  id                    String   @id @default(cuid())
  userId                String
  currency              String   @db.VarChar(3)
  protectedReserveMinor BigInt?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@map("finance_currency_policy")
}

enum SavingsGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model SavingsGoal {
  id                      String                         @id @default(cuid())
  userId                  String
  name                    String                         @db.VarChar(120)
  currency                String                         @db.VarChar(3)
  targetAmountMinor       BigInt
  allocatedAmountMinor    BigInt                         @default(0)
  status                  SavingsGoalStatus              @default(ACTIVE)
  completedAt             DateTime?
  archivedAt              DateTime?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  user                    User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses                SavingsGoalExpenseAllocation[]
  completionNeedsReviewAt DateTime?

  @@unique([id, userId])
  @@index([userId, currency, archivedAt])
  @@map("savings_goal")
}

model SavingsGoalExpenseAllocation {
  userId        String
  savingsGoalId String
  transactionId String
  amountMinor   BigInt
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          SavingsGoal          @relation(fields: [savingsGoalId, userId], references: [id, userId], onDelete: Restrict)
  transaction   FinancialTransaction @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Cascade)

  @@id([savingsGoalId, transactionId])
  @@index([userId, transactionId])
  @@map("savings_goal_expense_allocation")
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringPostingBehavior {
  ASK_TO_CONFIRM
  AUTOMATIC
}

enum RecurringExpenseStatus {
  ACTIVE
  PAUSED
}

model RecurringExpense {
  id                 String                       @id @default(cuid())
  userId             String
  name               String                       @db.VarChar(120)
  amountMinor        BigInt
  currency           String                       @db.VarChar(3)
  accountId          String
  expenseCategoryId  String?
  counterpartyId     String?
  frequency          RecurringFrequency
  dayOfWeek          Int?
  dayOfMonth         Int?
  monthOfYear        Int?
  startOn            DateTime                     @db.Date
  endOn              DateTime?                    @db.Date
  status             RecurringExpenseStatus       @default(ACTIVE)
  postingBehavior    RecurringPostingBehavior     @default(ASK_TO_CONFIRM)
  processedThroughOn DateTime                     @db.Date
  pausedOn           DateTime?                    @db.Date
  archivedAt         DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            FinancialAccount             @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  expenseCategory    ExpenseCategory?             @relation(fields: [expenseCategoryId, userId], references: [id, userId], onDelete: Restrict)
  counterparty       Counterparty?                @relation(fields: [counterpartyId, userId], references: [id, userId], onDelete: Restrict)
  occurrences        RecurringExpenseOccurrence[]

  @@unique([id, userId])
  @@index([userId, status, processedThroughOn])
  @@index([userId, counterpartyId])
  @@map("recurring_expense")
}

enum RecurringOccurrenceStatus {
  AWAITING_CONFIRMATION
  POSTED_AUTOMATICALLY
  POSTED_CONFIRMED
  SKIPPED
}

model RecurringExpenseOccurrence {
  id                      String                    @id @default(cuid())
  userId                  String
  recurringExpenseId      String
  dueOn                   DateTime                  @db.Date
  nameSnapshot            String                    @db.VarChar(120)
  scheduledAmountMinor    BigInt
  currency                String                    @db.VarChar(3)
  accountId               String
  expenseCategoryId       String?
  counterpartyId          String?
  postingBehaviorSnapshot RecurringPostingBehavior
  status                  RecurringOccurrenceStatus
  resolvedAt              DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringExpense        RecurringExpense          @relation(fields: [recurringExpenseId, userId], references: [id, userId], onDelete: Restrict)
  account                 FinancialAccount          @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  expenseCategory         ExpenseCategory?          @relation(fields: [expenseCategoryId, userId], references: [id, userId], onDelete: Restrict)
  counterparty            Counterparty?             @relation(fields: [counterpartyId, userId], references: [id, userId], onDelete: Restrict)
  transaction             FinancialTransaction?

  @@unique([id, userId])
  @@unique([recurringExpenseId, dueOn])
  @@index([userId, status, dueOn])
  @@index([userId, counterpartyId, dueOn])
  @@map("recurring_expense_occurrence")
}

enum FinanceCompensationType {
  HOURLY
  FIXED
  TASK_BASED
  UNKNOWN
}

enum WorkSourceType {
  EMPLOYER
  CLIENT
  PLATFORM
  OTHER
}

enum IncomeOpportunityStatus {
  DISCOVERED
  APPLIED
  ASSESSMENT
  ACCEPTED
  REJECTED
  ABANDONED
}

enum IncomeOpportunityChannel {
  DIRECT
  REFERRAL
  JOB_BOARD
  MARKETPLACE
  OUTREACH
  OTHER
}

model WorkSource {
  businessCompanies CompanyWorkSource[]
  id                      String                  @id @default(cuid())
  userId                  String
  name                    String                  @db.VarChar(120)
  type                    WorkSourceType
  defaultCompensationType FinanceCompensationType @default(UNKNOWN)
  notes                   String?
  archivedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities           IncomeOpportunity[]
  transactions            FinancialTransaction[]
  sessions                Session[]

  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@map("work_source")
}

model Offer {
  niches OfferNiche[]
  id String @id @default(cuid())
  userId String
  companyId String
  archivedAt DateTime?
  continuationChoice String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  revisions OfferRevision[]
  events OfferEvent[]
  followUps FollowUp[]
  @@unique([id, userId])
  @@unique([id, companyId, userId])
  @@index([userId, createdAt, id])
  @@map("offer")
}

model OfferNiche {
  userId String
  offerId String
  nicheId String
  nicheSnapshot String
  createdAt DateTime @default(now())
  offer Offer @relation(fields: [offerId, userId], references: [id, userId], onDelete: Cascade)
  niche Niche @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Restrict)
  @@id([offerId, nicheId])
  @@index([userId, nicheId])
  @@map("offer_niche")
}

model OfferRevision {
  id String @id @default(cuid())
  userId String
  offerId String
  companyId String
  version Int
  title String
  scope String
  terms String?
  companySnapshot String
  priceBasis String
  priceMinor BigInt?
  currency String?
  unitLabel String?
  intervalUnit String?
  intervalCount Int?
  expiresOn DateTime? @db.Date
  proposedAt DateTime?
  createdAt DateTime @default(now())
  offer Offer @relation(fields: [offerId, companyId, userId], references: [id, companyId, userId], onDelete: Cascade)
  problems OfferRevisionProblem[]
  events OfferEvent[]
  receipts BusinessReceiptAllocation[]
  @@unique([offerId, version])
  @@unique([id, offerId, userId])
  @@unique([id, companyId, userId])
  @@map("offer_revision")
}

model OfferRevisionProblem {
  userId String
  offerId String
  offerRevisionId String
  problemId String
  revision OfferRevision @relation(fields: [offerRevisionId, offerId, userId], references: [id, offerId, userId], onDelete: Cascade)
  problem Problem @relation(fields: [problemId, userId], references: [id, userId], onDelete: Restrict)
  @@id([offerRevisionId, problemId])
  @@map("offer_revision_problem")
}

model OfferEvent {
  id String @id @default(cuid())
  userId String
  offerId String
  offerRevisionId String
  kind String
  occurredAt DateTime
  sourceDescription String
  interactionId String?
  interactionRevisionId String?
  retractedAt DateTime?
  retractionReason String?
  createdAt DateTime @default(now())
  offer Offer @relation(fields: [offerId, userId], references: [id, userId], onDelete: Cascade)
  revision OfferRevision @relation(fields: [offerRevisionId, offerId, userId], references: [id, offerId, userId], onDelete: Cascade)
  interactionRevision InteractionRevision? @relation(fields: [interactionRevisionId, interactionId, userId], references: [id, interactionId, userId], onDelete: Restrict)
  @@unique([id, userId])
  @@index([offerId, occurredAt])
  @@map("offer_event")
}

model CompanyWorkSource {
  userId String
  companyId String
  workSourceId String
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId, userId], references: [id, userId], onDelete: Cascade)
  workSource WorkSource @relation(fields: [workSourceId, userId], references: [id, userId], onDelete: Restrict)
  @@id([companyId, workSourceId])
  @@map("company_work_source")
}

model BusinessReceiptAllocation {
  sourceChangedAt DateTime?
  id String @id @default(cuid())
  userId String
  transactionId String?
  originalTransactionId String
  companyId String
  offerRevisionId String?
  amountMinor BigInt
  currencySnapshot String
  occurredAtSnapshot DateTime
  companySnapshot String
  note String?
  confirmedAt DateTime @default(now())
  needsReviewAt DateTime?
  withdrawnAt DateTime?
  withdrawalReason String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction FinancialTransaction? @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Restrict)
  company Company @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  offerRevision OfferRevision? @relation(fields: [offerRevisionId, companyId, userId], references: [id, companyId, userId], onDelete: Restrict)
  evidence ProblemEvidence[]
  @@unique([id, userId])
  @@index([transactionId, withdrawnAt])
  @@index([userId, companyId, withdrawnAt])
  @@map("business_receipt_allocation")
}

model IncomeOpportunity {
  id                    String                    @id @default(cuid())
  userId                String
  title                 String                    @db.VarChar(120)
  organizationName      String?                   @db.VarChar(120)
  status                IncomeOpportunityStatus   @default(DISCOVERED)
  channel               IncomeOpportunityChannel?
  discoveredAt          DateTime
  appliedAt             DateTime?
  assessmentAt          DateTime?
  closedAt              DateTime?
  resultingWorkSourceId String?
  compensationType      FinanceCompensationType?
  expectedAmountMinor   BigInt?
  expectedCurrency      String?                   @db.VarChar(3)
  notes                 String?
  archivedAt            DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultingWorkSource   WorkSource?               @relation(fields: [resultingWorkSourceId, userId], references: [id, userId], onDelete: Restrict)
  transactions          FinancialTransaction[]
  sessions              Session[]

  @@unique([id, userId])
  @@index([userId, archivedAt, discoveredAt])
  @@map("income_opportunity")
}

enum FinanceActivityKind {
  PAID_WORK
  OPPORTUNITY_SEARCH
  APPLICATION
  ASSESSMENT
  FINANCE_ADMIN
}

model PaymentSessionAllocation {
  userId        String
  transactionId String
  sessionId     String
  amountMinor   BigInt
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Cascade)
  session       Session              @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Restrict)

  @@id([transactionId, sessionId])
  @@index([userId, sessionId])
  @@map("payment_session_allocation")
}
