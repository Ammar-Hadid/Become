generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum EngineeringProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
}

enum EngineeringContext {
  UNI
  INTERNSHIP
  PERSONAL
  PROFESSIONAL
}

enum EngineeringEvidenceType {
  FEATURE_COMPLETED
  BUG_SOLVED
  CONCEPT_LEARNED
  DEPLOYMENT
  ARCHITECTURE_DECISION
  TECHNICAL_DISCOVERY
}

enum TechnologyCategory {
  LANGUAGE
  FRAMEWORK
  LIBRARY
  DATABASE
  RUNTIME
  ORM_DATA
  TESTING
  BUILD_TOOL
  INFRASTRUCTURE
  PLATFORM
  TOOL
  OTHER
}

model User {
  bankConnections              BankConnection[]
  externalBankAccounts         ExternalBankAccount[]
  bankSyncJobs                 BankSyncJob[]
  financialEvidence            FinancialEvidenceObservation[]
  financialEvidenceLinks       FinancialEvidenceLink[]
  financialBalanceObservations FinancialBalanceObservation[]
  financialStatementImports    FinancialStatementImport[]
  counterpartyIdentities       CounterpartyIdentity[]
  expectedIncome               FinanceExpectedIncome[]
  nexoSettings                 NexoSettings?
  nexoSettingsRevisions        NexoSettingsRevision[]
  nexoRuns                     NexoRun[]
  interviewGuides              InterviewGuide[]
  conversationMessages         ConversationMessage[]
  explorationClaims            ExplorationClaim[]
  explorationUncertainties     ExplorationUncertainty[]
  explorationSnapshotEditions  ExplorationSnapshotEdition[]
  audienceContexts             AudienceContext[]
  offerEngagements             OfferEngagement[]
  marketPeople                 Person[]
  audienceSegments             AudienceSegment[]
  reviews                      Review[]
  reviewMutations              ReviewMutation[]
  seasonTransitions            SeasonTransition[]
  timerRevision                Int                            @default(0)
  contents                     Content[]
  contentChannels              Channel[]
  ideas                        Idea[]
  decisions                    Decision[]
  contentMutations             ContentMutation[]
  thinkingMutations            ThinkingMutation[]

  seasons                    UserSeason[]
  directionGoals             Goal[]
  directionExperiments       Experiment[]
  businessOffers             Offer[]
  businessReceiptAllocations BusinessReceiptAllocation[]
  businessInteractions       Interaction[]
  businessObservations       Observation[]
  businessProblems           Problem[]
  businessFollowUps          FollowUp[]
  businessCompanies          Company[]
  businessNiches             Niche[]
  businessCaptures           BusinessCapture[]
  id                         String                            @id @default(cuid())
  name                       String
  email                      String                            @unique
  emailVerified              Boolean                           @default(false)
  image                      String?
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt
  authSessions               AuthSession[]
  accounts                   Account[]
  domains                    Domain[]
  sessions                   Session[]
  engineeringProjects        EngineeringProject[]
  engineeringEvidence        EngineeringEvidence[]
  technologies               Technology[]
  financialAccounts          FinancialAccount[]
  balanceSnapshots           FinancialAccountBalanceSnapshot[]

  financialTransactions FinancialTransaction[]
  expenseCategories     ExpenseCategory[]
  counterparties        Counterparty[]

  financePolicies FinanceCurrencyPolicy[]

  savingsGoals SavingsGoal[]
  goalExpenses SavingsGoalExpenseAllocation[]

  recurringExpenses RecurringExpense[]

  recurringOccurrences RecurringExpenseOccurrence[]

  workSources         WorkSource[]
  incomeOpportunities IncomeOpportunity[]

  paymentAllocations PaymentSessionAllocation[]

  @@map("user")
}

model Company {
  engagements          OfferEngagement[]
  problems             Problem[]
  directionCriteria    DirectionCriterion[]
  businessSessions     Session[]                   @relation("BusinessSessionCompany")
  offers               Offer[]
  receiptAllocations   BusinessReceiptAllocation[]
  workSources          CompanyWorkSource[]
  interactionRevisions InteractionRevision[]
  observationRevisions ObservationRevision[]
  followUps            FollowUp[]
  id                   String                      @id @default(cuid())
  userId               String
  name                 String
  normalizedName       String
  website              String?
  notes                String?
  archivedAt           DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  niches               CompanyNiche[]

  @@unique([id, userId])
  @@unique([userId, normalizedName])
  @@index([userId, createdAt, id])
  @@map("company")
}

model Niche {
  interviewGuides          InterviewGuide[]
  explorationClaims        ExplorationClaim[]
  explorationUncertainties ExplorationUncertainty[]
  snapshotEditions         ExplorationSnapshotEdition[]
  receipts                 BusinessReceiptAllocation[]
  marketFocus              String?                      @default("UNKNOWN")
  marketConclusion         String?                      @default("UNDECIDED")
  people                   PersonNiche[]
  segments                 AudienceSegmentNiche[]
  journalDecisions         Decision[]

  directionCriteria    DirectionCriterion[]
  businessSessions     Session[]             @relation("BusinessSessionNiche")
  interactionRevisions InteractionRevision[]
  observationRevisions ObservationRevision[]
  problems             Problem[]
  id                   String                @id @default(cuid())
  userId               String
  name                 String
  normalizedName       String
  scope                String?
  direction            String                @default("EXPLORING")
  archivedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  companies            CompanyNiche[]
  decisions            NicheDecision[]
  offers               OfferNiche[]

  @@unique([id, userId])
  @@unique([userId, normalizedName])
  @@map("niche")
}

model ExplorationClaim {
  id              String                     @id @default(cuid())
  userId          String
  nicheId         String
  version         Int                        @default(1)
  archivedAt      DateTime?
  createdAt       DateTime                   @default(now())
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche           Niche                      @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Cascade)
  revisions       ExplorationClaimRevision[]
  snapshotEntries ExplorationSnapshotClaim[]

  @@unique([id, userId])
  @@unique([id, nicheId, userId])
  @@index([nicheId, archivedAt, createdAt, id])
  @@map("exploration_claim")
}

model ExplorationClaimRevision {
  sourceManifest   Json?
  id               String                     @id @default(cuid())
  userId           String
  nicheId          String
  claimId          String
  version          Int
  lane             String
  kind             String
  statement        String
  correctionReason String?
  createdAt        DateTime                   @default(now())
  claim            ExplorationClaim           @relation(fields: [claimId, nicheId, userId], references: [id, nicheId, userId], onDelete: Cascade)
  citations        ExplorationClaimCitation[]
  snapshotEntries  ExplorationSnapshotClaim[]

  @@unique([claimId, version])
  @@unique([id, userId])
  @@unique([id, claimId, userId])
  @@index([nicheId, createdAt, id])
  @@map("exploration_claim_revision")
}

model ExplorationClaimCitation {
  id                    String                   @id @default(cuid())
  userId                String
  claimRevisionId       String
  observationId         String
  observationRevisionId String
  stance                String
  note                  String?
  createdAt             DateTime                 @default(now())
  claimRevision         ExplorationClaimRevision @relation(fields: [claimRevisionId, userId], references: [id, userId], onDelete: Cascade)
  observation           Observation              @relation("LogicalObservationClaimCitation", fields: [observationId, userId], references: [id, userId], onDelete: Restrict)
  observationRevision   ObservationRevision      @relation("ObservationVersionClaimCitation", fields: [observationRevisionId, observationId, userId], references: [id, observationId, userId], onDelete: Restrict)

  @@unique([claimRevisionId, observationRevisionId])
  @@index([observationId, observationRevisionId])
  @@map("exploration_claim_citation")
}

model ExplorationUncertainty {
  id              String                           @id @default(cuid())
  userId          String
  nicheId         String
  version         Int                              @default(1)
  resolvedAt      DateTime?
  archivedAt      DateTime?
  createdAt       DateTime                         @default(now())
  user            User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche           Niche                            @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Cascade)
  revisions       ExplorationUncertaintyRevision[]
  snapshotEntries ExplorationSnapshotUncertainty[]

  @@unique([id, userId])
  @@unique([id, nicheId, userId])
  @@index([nicheId, resolvedAt, archivedAt, createdAt, id])
  @@map("exploration_uncertainty")
}

model ExplorationUncertaintyRevision {
  kind             String                           @default("QUESTION")
  sourceManifest   Json?
  id               String                           @id @default(cuid())
  userId           String
  nicheId          String
  uncertaintyId    String
  version          Int
  lane             String
  statement        String
  correctionReason String?
  createdAt        DateTime                         @default(now())
  uncertainty      ExplorationUncertainty           @relation(fields: [uncertaintyId, nicheId, userId], references: [id, nicheId, userId], onDelete: Cascade)
  snapshotEntries  ExplorationSnapshotUncertainty[]

  @@unique([uncertaintyId, version])
  @@unique([id, userId])
  @@unique([id, uncertaintyId, userId])
  @@index([nicheId, createdAt, id])
  @@map("exploration_uncertainty_revision")
}

model ExplorationSnapshotEdition {
  synthesis      Json?
  id             String                           @id @default(cuid())
  userId         String
  nicheId        String
  number         Int
  coverage       Json
  recommendation Json
  sourceCursor   Json
  publishedAt    DateTime                         @default(now())
  user           User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche          Niche                            @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Cascade)
  claims         ExplorationSnapshotClaim[]
  uncertainties  ExplorationSnapshotUncertainty[]

  @@unique([id, userId])
  @@unique([nicheId, number])
  @@index([nicheId, publishedAt, id])
  @@map("exploration_snapshot_edition")
}

model ExplorationSnapshotClaim {
  userId          String
  editionId       String
  claimId         String
  claimRevisionId String
  position        Int
  edition         ExplorationSnapshotEdition @relation(fields: [editionId, userId], references: [id, userId], onDelete: Cascade)
  claim           ExplorationClaim           @relation(fields: [claimId, userId], references: [id, userId], onDelete: Restrict)
  claimRevision   ExplorationClaimRevision   @relation(fields: [claimRevisionId, claimId, userId], references: [id, claimId, userId], onDelete: Restrict)

  @@id([editionId, claimId])
  @@unique([editionId, position])
  @@map("exploration_snapshot_claim")
}

model ExplorationSnapshotUncertainty {
  userId                String
  editionId             String
  uncertaintyId         String
  uncertaintyRevisionId String
  position              Int
  edition               ExplorationSnapshotEdition     @relation(fields: [editionId, userId], references: [id, userId], onDelete: Cascade)
  uncertainty           ExplorationUncertainty         @relation(fields: [uncertaintyId, userId], references: [id, userId], onDelete: Restrict)
  uncertaintyRevision   ExplorationUncertaintyRevision @relation(fields: [uncertaintyRevisionId, uncertaintyId, userId], references: [id, uncertaintyId, userId], onDelete: Restrict)

  @@id([editionId, uncertaintyId])
  @@unique([editionId, position])
  @@map("exploration_snapshot_uncertainty")
}

model Interaction {
  experimentSources    ExperimentSource[]
  id                   String                @id @default(cuid())
  userId               String
  version              Int                   @default(1)
  status               String                @default("COMPLETED")
  voidedAt             DateTime?
  voidReason           String?
  createdAt            DateTime              @default(now())
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions            InteractionRevision[] @relation("InteractionHistory")
  replies              InteractionRevision[] @relation("ReplyTarget")
  followUps            FollowUp[]
  interviewSession     InterviewSession?
  conversationMessages ConversationMessage[]

  @@unique([id, userId])
  @@index([userId, createdAt, id])
  @@map("interaction")
}

model InterviewGuide {
  id                      String                   @id @default(cuid())
  userId                  String
  nicheId                 String
  segmentId               String?
  version                 Int                      @default(1)
  title                   String
  objective               String
  marketType              String
  expectedDurationMinutes Int
  draftDocument           Json
  savedAt                 DateTime                 @default(now())
  archivedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche                   Niche                    @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Cascade)
  segment                 AudienceSegment?         @relation(fields: [segmentId, userId], references: [id, userId], onDelete: Restrict)
  revisions               InterviewGuideRevision[]

  @@unique([id, userId])
  @@index([nicheId, archivedAt, updatedAt, id])
  @@map("interview_guide")
}

model InterviewGuideRevision {
  id                      String             @id @default(cuid())
  userId                  String
  guideId                 String
  version                 Int
  titleSnapshot           String
  objectiveSnapshot       String
  marketType              String
  segmentId               String?
  segmentSnapshot         String?
  expectedDurationMinutes Int
  document                Json
  questionIndex           Json               @default("[]")
  publishedAt             DateTime           @default(now())
  guide                   InterviewGuide     @relation(fields: [guideId, userId], references: [id, userId], onDelete: Cascade)
  interviewSessions       InterviewSession[]

  @@unique([guideId, version])
  @@unique([id, userId])
  @@index([guideId, publishedAt, id])
  @@map("interview_guide_revision")
}

model InterviewSession {
  interactionId      String                  @id
  userId             String
  guideRevisionId    String?
  status             String                  @default("DRAFT")
  currentQuestionId  String?
  skippedQuestionIds Json                    @default("[]")
  outcome            String?
  nextAction         String?
  takeaways          Json                    @default("[]")
  summary            String?
  cancelReason       String?
  guideCompletedAt   DateTime?
  debriefCompletedAt DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  interaction        Interaction             @relation(fields: [interactionId, userId], references: [id, userId], onDelete: Cascade)
  guideRevision      InterviewGuideRevision? @relation(fields: [guideRevisionId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([interactionId, userId])
  @@index([userId, status, updatedAt])
  @@map("interview_session")
}

model ConversationMessage {
  id                   String                        @id @default(cuid())
  userId               String
  interactionId        String
  version              Int                           @default(1)
  position             Int
  operationKey         String
  bookmarkedAt         DateTime?
  voidedAt             DateTime?
  voidReason           String?
  createdAt            DateTime                      @default(now())
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  interaction          Interaction                   @relation(fields: [interactionId, userId], references: [id, userId], onDelete: Cascade)
  revisions            ConversationMessageRevision[]
  observationRevisions ObservationRevision[]         @relation("MessageObservation")

  @@unique([id, userId])
  @@unique([id, interactionId, userId])
  @@unique([userId, operationKey])
  @@unique([interactionId, position])
  @@index([interactionId, voidedAt, position])
  @@map("conversation_message")
}

model ConversationMessageRevision {
  id                   String                @id @default(cuid())
  userId               String
  messageId            String
  interactionId        String
  version              Int
  speakerRole          String
  speakerNameSnapshot  String
  body                 String
  occurredAt           DateTime
  channel              String
  platform             String?
  guideQuestionId      String?
  correctionReason     String?
  createdAt            DateTime              @default(now())
  message              ConversationMessage   @relation(fields: [messageId, interactionId, userId], references: [id, interactionId, userId], onDelete: Cascade)
  observationRevisions ObservationRevision[] @relation("MessageRevisionObservation")

  @@unique([messageId, version])
  @@unique([id, messageId, userId])
  @@unique([id, messageId, interactionId, userId])
  @@index([interactionId, occurredAt, id])
  @@map("conversation_message_revision")
}

model InteractionRevision {
  linkedParticipants InteractionParticipant[]
  sampleUnit         String?
  audienceContextId  String?
  audienceContext    AudienceContext?         @relation(fields: [audienceContextId, userId], references: [id, userId], onDelete: Restrict)
  identityKind       String                   @default("UNSPECIFIED")
  sampleSize         Int?
  personId           String?
  personSnapshot     String?
  audienceLabel      String?
  person             Person?                  @relation(fields: [personId, userId], references: [id, userId], onDelete: Restrict)

  sourceSessionId         String?
  sourceSession           Session?              @relation(fields: [sourceSessionId, userId], references: [id, userId], onDelete: Restrict)
  offerEvents             OfferEvent[]
  id                      String                @id @default(cuid())
  userId                  String
  interactionId           String
  version                 Int
  companyId               String?
  nicheId                 String?
  companySnapshot         String?
  nicheSnapshot           String?
  respondsToInteractionId String?
  kind                    String
  channel                 String
  platform                String?
  occurredAt              DateTime
  datePrecision           String                @default("DAY")
  summary                 String
  notes                   String?
  participants            Json                  @default("[]")
  correctionReason        String?
  materialChange          Boolean               @default(false)
  createdAt               DateTime              @default(now())
  interaction             Interaction           @relation("InteractionHistory", fields: [interactionId, userId], references: [id, userId], onDelete: Cascade)
  company                 Company?              @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  niche                   Niche?                @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Restrict)
  respondsTo              Interaction?          @relation("ReplyTarget", fields: [respondsToInteractionId, userId], references: [id, userId], onDelete: Restrict)
  observations            ObservationRevision[]

  @@unique([interactionId, version])
  @@unique([id, interactionId, userId])
  @@unique([id, userId])
  @@index([userId, occurredAt, id])
  @@index([companyId, occurredAt])
  @@map("interaction_revision")
}

model Observation {
  id             String                     @id @default(cuid())
  userId         String
  version        Int                        @default(1)
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime                   @default(now())
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions      ObservationRevision[]
  evidence       ProblemEvidence[]          @relation("LogicalObservationEvidence")
  claimCitations ExplorationClaimCitation[] @relation("LogicalObservationClaimCitation")

  @@unique([id, userId])
  @@map("observation")
}

model ObservationRevision {
  sampleUnit        String?
  audienceContextId String?
  audienceContext   AudienceContext? @relation(fields: [audienceContextId, userId], references: [id, userId], onDelete: Restrict)
  identityKind      String           @default("UNSPECIFIED")
  sampleSize        Int?
  personId          String?
  personSnapshot    String?
  audienceLabel     String?
  person            Person?          @relation(fields: [personId, userId], references: [id, userId], onDelete: Restrict)

  id                      String                       @id @default(cuid())
  userId                  String
  observationId           String
  version                 Int
  kind                    String
  wordingMode             String
  statement               String
  observedAt              DateTime
  companyId               String?
  nicheId                 String?
  companySnapshot         String?
  nicheSnapshot           String?
  sourceKind              String
  interactionId           String?
  interactionRevisionId   String?
  sourceMessageId         String?
  sourceMessageRevisionId String?
  sourceUrl               String?
  sourceDescription       String
  correctionReason        String?
  materialChange          Boolean                      @default(false)
  createdAt               DateTime                     @default(now())
  observation             Observation                  @relation(fields: [observationId, userId], references: [id, userId], onDelete: Cascade)
  company                 Company?                     @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  niche                   Niche?                       @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Restrict)
  interactionRevision     InteractionRevision?         @relation(fields: [interactionRevisionId, interactionId, userId], references: [id, interactionId, userId], onDelete: Restrict)
  sourceMessage           ConversationMessage?         @relation("MessageObservation", fields: [sourceMessageId, interactionId, userId], references: [id, interactionId, userId], onDelete: Restrict)
  sourceMessageRevision   ConversationMessageRevision? @relation("MessageRevisionObservation", fields: [sourceMessageRevisionId, sourceMessageId, interactionId, userId], references: [id, messageId, interactionId, userId], onDelete: Restrict)
  evidence                ProblemEvidence[]            @relation("ObservationVersionEvidence")
  claimCitations          ExplorationClaimCitation[]   @relation("ObservationVersionClaimCitation")

  @@unique([observationId, version])
  @@unique([id, observationId, userId])
  @@map("observation_revision")
}

model Problem {
  audienceRevisions ProblemAudienceRevision[]
  audienceContextId String?
  audienceContext   AudienceContext?          @relation(fields: [audienceContextId, userId], references: [id, userId], onDelete: Restrict)
  identityKind      String                    @default("UNSPECIFIED")
  companyId         String?
  companySnapshot   String?
  company           Company?                  @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  personId          String?
  personSnapshot    String?
  audienceLabel     String?
  person            Person?                   @relation(fields: [personId, userId], references: [id, userId], onDelete: Restrict)

  offerRevisions   OfferRevisionProblem[]
  id               String                 @id @default(cuid())
  userId           String
  title            String
  initialStatement String
  origin           String
  formulatedAt     DateTime               @default(now())
  nicheId          String?
  nicheSnapshot    String?
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime               @default(now())
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche            Niche?                 @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Restrict)
  evidence         ProblemEvidence[]
  assessments      ProblemAssessment[]

  @@unique([id, userId])
  @@index([userId, createdAt, id])
  @@map("problem")
}

model ProblemEvidence {
  receiptSnapshot       Json?
  receiptAllocationId   String?
  receiptAllocation     BusinessReceiptAllocation?  @relation(fields: [receiptAllocationId, userId], references: [id, userId], onDelete: Restrict)
  id                    String                      @id @default(cuid())
  userId                String
  problemId             String
  observationId         String?
  observationRevisionId String?
  stance                String
  explanation           String
  confirmedAt           DateTime                    @default(now())
  withdrawnAt           DateTime?
  withdrawalReason      String?
  createdAt             DateTime                    @default(now())
  problem               Problem                     @relation(fields: [problemId, userId], references: [id, userId], onDelete: Cascade)
  observation           Observation?                @relation("LogicalObservationEvidence", fields: [observationId, userId], references: [id, userId], onDelete: Restrict)
  observationRevision   ObservationRevision?        @relation("ObservationVersionEvidence", fields: [observationRevisionId, observationId, userId], references: [id, observationId, userId], onDelete: Restrict)
  assessmentBasis       ProblemAssessmentEvidence[]

  @@unique([id, problemId, userId])
  @@index([problemId, withdrawnAt])
  @@map("problem_evidence")
}

model ProblemAssessment {
  audienceRevisionId String?
  audienceRevision   ProblemAudienceRevision?    @relation(fields: [audienceRevisionId, problemId, userId], references: [id, problemId, userId], onDelete: Restrict)
  id                 String                      @id @default(cuid())
  userId             String
  problemId          String
  state              String
  scope              String
  rationale          String
  assessedAt         DateTime
  createdAt          DateTime                    @default(now())
  problem            Problem                     @relation(fields: [problemId, userId], references: [id, userId], onDelete: Cascade)
  basis              ProblemAssessmentEvidence[]

  @@unique([id, problemId, userId])
  @@index([problemId, assessedAt])
  @@map("problem_assessment")
}

model ProblemAssessmentEvidence {
  userId       String
  problemId    String
  assessmentId String
  evidenceId   String
  assessment   ProblemAssessment @relation(fields: [assessmentId, problemId, userId], references: [id, problemId, userId], onDelete: Cascade)
  evidence     ProblemEvidence   @relation(fields: [evidenceId, problemId, userId], references: [id, problemId, userId], onDelete: Restrict)

  @@id([assessmentId, evidenceId])
  @@map("problem_assessment_evidence")
}

model FollowUp {
  offerId       String?
  offer         Offer?       @relation(fields: [offerId, userId], references: [id, userId], onDelete: Restrict)
  id            String       @id @default(cuid())
  userId        String
  companyId     String?
  interactionId String?
  title         String
  dueOn         DateTime?    @db.Date
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company?     @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  interaction   Interaction? @relation(fields: [interactionId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([id, userId])
  @@index([userId, dueOn, completedAt])
  @@map("follow_up")
}

model CompanyNiche {
  userId    String
  companyId String
  nicheId   String
  company   Company @relation(fields: [companyId, userId], references: [id, userId], onDelete: Cascade)
  niche     Niche   @relation(fields: [nicheId, userId], references: [id, userId], onDelete: Restrict)

  @@id([companyId, nicheId])
  @@map("company_niche")
}

model NicheDecision {
  sourceSnapshots  Json     @default("[]")
  conclusionScope  String?
  marketFocus      String?  @default("UNKNOWN")
