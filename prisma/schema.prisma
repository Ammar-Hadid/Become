enum FinancialDataSource {
  LIVE_SYNC
  STATEMENT_IMPORT
  MANUAL
}

enum CreditCardRepaymentMethod {
  LINKED_ACCOUNT
  MANUAL
}

enum BankingConnectionStatus {
  AUTHORIZING
  CONNECTED
  REAUTH_REQUIRED
  DISCONNECTED
  FAILED
}

enum BankSyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum BankSyncTrigger {
  INITIAL
  SCHEDULED
  USER
}

enum FinancialBookingStatus {
  PENDING
  BOOKED
}

enum FinancialMovementDirection {
  DEBIT
  CREDIT
}

enum FinancialDatePrecision {
  DATE
  INSTANT
}

enum FinancialEvidenceStatus {
  STAGED
  PROJECTED
  DUPLICATE_REVIEW
  SUPERSEDED
  IGNORED
}

model BankConnection {
  id                      String                  @id @default(cuid())
  userId                  String
  provider                String                  @db.VarChar(80)
  institutionName         String                  @db.VarChar(160)
  institutionCountry      String                  @db.VarChar(2)
  institutionLogo         String?
  status                  BankingConnectionStatus @default(AUTHORIZING)
  sessionId               String?
  consentExpiresAt        DateTime?
  lastSuccessAt           DateTime?
  nextEligibleAt          DateTime?
  authorizationStateHash  String?                 @unique
  authorizationExpiresAt  DateTime?
  authorizationConsumedAt DateTime?
  requiredPsuHeaders      Json?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalAccounts        ExternalBankAccount[]
  jobs                    BankSyncJob[]

  @@unique([id, userId])
  @@index([status, nextEligibleAt])
  @@map("bank_connection")
}

model ExternalBankAccount {
  id                  String                         @id @default(cuid())
  userId              String
  connectionId        String
  provider            String                         @db.VarChar(80)
  identityKey         String
  identityAliases     Json?
  authorizedSessionId String?
  providerAccountId   String
  externalType        String?
  currency            String                         @db.VarChar(3)
  maskedIdentifier    String?
  financialAccountId  String?
  lastSuccessAt       DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  user                User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection          BankConnection                 @relation(fields: [connectionId, userId], references: [id, userId], onDelete: Restrict)
  financialAccount    FinancialAccount?              @relation(fields: [financialAccountId, userId, currency], references: [id, userId, currency], onDelete: Restrict)
  evidence            FinancialEvidenceObservation[]
  balances            FinancialBalanceObservation[]
  jobs                BankSyncJob[]

  @@unique([id, userId])
  @@unique([userId, provider, identityKey])
  @@index([userId, financialAccountId])
  @@map("external_bank_account")
}

model BankSyncJob {
  id                String               @id @default(cuid())
  userId            String
  connectionId      String
  externalAccountId String?
  status            BankSyncJobStatus    @default(QUEUED)
  trigger           BankSyncTrigger      @default(SCHEDULED)
  arguments         Json                 @default("{}")
  cursor            Json?
  attempts          Int                  @default(0)
  nextAttemptAt     DateTime             @default(now())
  leaseToken        String?
  leasedUntil       DateTime?
  lastError         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection        BankConnection       @relation(fields: [connectionId, userId], references: [id, userId], onDelete: Restrict)
  externalAccount   ExternalBankAccount? @relation(fields: [externalAccountId, userId], references: [id, userId], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@map("bank_sync_job")
}

model FinancialStatementImport {
  id                String                         @id @default(cuid())
  userId            String
  accountId         String
  fileName          String                         @db.VarChar(180)
  fileHash          String
  format            String
  coverageFromOn    String?                        @db.VarChar(10)
  coverageThroughOn String?                        @db.VarChar(10)
  status            String                         @default("PREVIEW")
  errors            Json                           @default("[]")
  confirmedAt       DateTime?
  createdAt         DateTime                       @default(now())
  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           FinancialAccount               @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  observations      FinancialEvidenceObservation[]

  @@unique([id, userId])
  @@unique([userId, accountId, fileHash])
  @@map("financial_statement_import")
}

model FinancialEvidenceObservation {
  id                      String                     @id @default(cuid())
  userId                  String
  accountId               String?
  externalAccountId       String?
  importId                String?
  source                  FinancialDataSource
  evidenceKey             String
  payloadHash             String
  externalReference       String?
  fingerprint             String
  bookingStatus           FinancialBookingStatus
  direction               FinancialMovementDirection
  amountMinor             BigInt
  currency                String                     @db.VarChar(3)
  activityOn              String                     @db.VarChar(10)
  occurredAt              DateTime
  datePrecision           FinancialDatePrecision     @default(DATE)
  bookingOn               String?                    @db.VarChar(10)
  valueOn                 String?                    @db.VarChar(10)
  counterpartyName        String?
  counterpartyIdentity    String?
  ownCounterpartyIdentity String?
  description             String?
  raw                     Json
  observedAt              DateTime                   @default(now())
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                 FinancialAccount?          @relation(fields: [accountId, userId, currency], references: [id, userId, currency], onDelete: Restrict)
  externalAccount         ExternalBankAccount?       @relation(fields: [externalAccountId, userId], references: [id, userId], onDelete: Restrict)
  statementImport         FinancialStatementImport?  @relation(fields: [importId, userId], references: [id, userId], onDelete: Restrict)
  link                    FinancialEvidenceLink?

  @@unique([id, userId])
  @@unique([userId, evidenceKey, payloadHash])
  @@index([userId, externalAccountId, observedAt])
  @@index([userId, fingerprint])
  @@map("financial_evidence_observation")
}

model FinancialEvidenceLink {
  id                  String                       @id @default(cuid())
  userId              String
  observationId       String                       @unique
  accountId           String?
  transactionId       String?
  status              FinancialEvidenceStatus      @default(STAGED)
  duplicateCandidates String[]                     @default([])
  needsAttention      String?
  resolvedAt          DateTime?
  createdAt           DateTime                     @default(now())
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  observation         FinancialEvidenceObservation @relation(fields: [observationId, userId], references: [id, userId], onDelete: Restrict)
  account             FinancialAccount?            @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  transaction         FinancialTransaction?        @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([id, userId])
  @@unique([observationId, userId])
  @@index([userId, transactionId, status])
  @@index([userId, accountId, status])
  @@map("financial_evidence_link")
}

model FinancialBalanceObservation {
  id                String               @id @default(cuid())
  userId            String
  accountId         String?
  externalAccountId String?
  source            FinancialDataSource
  balanceMinor      BigInt
  currency          String               @db.VarChar(3)
  balanceType       String
  includesPending   Boolean              @default(false)
  observedAt        DateTime
  payloadHash       String
  raw               Json
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           FinancialAccount?    @relation(fields: [accountId, userId, currency], references: [id, userId, currency], onDelete: Restrict)
  externalAccount   ExternalBankAccount? @relation(fields: [externalAccountId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, payloadHash])
  @@index([userId, accountId, observedAt])
  @@index([userId, externalAccountId, observedAt])
  @@map("financial_balance_observation")
}

model CounterpartyIdentity {
  id                String           @id @default(cuid())
  userId            String
  identityKey       String
  counterpartyId    String
  defaultCategoryId String?
  confirmedAt       DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  counterparty      Counterparty     @relation(fields: [counterpartyId, userId], references: [id, userId], onDelete: Restrict)
  defaultCategory   ExpenseCategory? @relation(fields: [defaultCategoryId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, identityKey])
  @@map("counterparty_identity")
}

model FinanceExpectedIncome {
  counterpartyId String?
  counterparty Counterparty? @relation(fields: [counterpartyId, userId], references: [id, userId], onDelete: Restrict, map: "finance_expected_income_counterparty_fkey")
  transactions FinancialTransaction[]
  id                  String              @id @default(cuid())
  userId              String
  accountId           String
  title               String              @db.VarChar(120)
  amountMinor         BigInt
  currency            String              @db.VarChar(3)
  dueOn               String              @db.VarChar(10)
  recurrenceFrequency RecurringFrequency?
  anchorDate          String?             @db.VarChar(10)
  confirmedAt         DateTime            @default(now())
  archivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account             FinancialAccount    @relation(fields: [accountId, userId, currency], references: [id, userId, currency], onDelete: Restrict)

  @@unique([id, userId])
  @@index([userId, dueOn])
  @@map("finance_expected_income")
}
